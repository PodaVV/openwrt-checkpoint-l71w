#!/bin/sh /etc/rc.common
# WAN failover watchdog service (see /usr/sbin/wan-failover) - 2026-11-18
USE_PROCD=1
START=99
STOP=10

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/wan-failover
	procd_set_param respawn
	procd_close_instance
}

stop_service() {
	/usr/sbin/wan-failover restore
}
