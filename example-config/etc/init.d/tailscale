#!/bin/sh /etc/rc.common
# Tailscale 1.104.7 static (pkgs.tailscale.com), userspace networking - installed 2026-11-18
USE_PROCD=1
START=99
STOP=1

start_service() {
    mkdir -p /etc/tailscale /var/run/tailscale
    procd_open_instance
    procd_set_param command /usr/sbin/tailscaled --tun=userspace-networking --state=/etc/tailscale/tailscaled.state --statedir=/etc/tailscale --socket=/var/run/tailscale/tailscaled.sock --port=41641 --no-logs-no-support
    procd_set_param respawn
    procd_set_param stderr 1
    procd_close_instance
}
