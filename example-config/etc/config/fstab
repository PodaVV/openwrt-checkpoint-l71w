
config global
	option anon_swap '0'
	option anon_mount '0'
	option auto_swap '1'
	option auto_mount '1'
	option delay_root '5'
	option check_fs '0'

config mount
	# UUID of your card: block info /dev/sda1
	option target '/mnt/sd'
	option uuid 'YOUR-CARD-UUID'
	option enabled '1'
	option options 'noatime'

