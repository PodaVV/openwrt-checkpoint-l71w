
config system
	option hostname 'OpenWrt'
	option timezone 'EET-2EEST,M3.5.0/3,M10.5.0/4'
	option zonename 'Europe/Kyiv'
	option ttylogin '0'
	option log_size '1024'
	option urandom_seed '0'
	option clock_hourcycle 'h23'
	option log_proto 'udp'
	option conloglevel '4'
	option log_file '/mnt/sd/logs/messages'

config timeserver 'ntp'
	list server '0.openwrt.pool.ntp.org'
	list server '1.openwrt.pool.ntp.org'
	list server '2.openwrt.pool.ntp.org'
	list server '3.openwrt.pool.ntp.org'

config led
	option name 'Wi-Fi'
	option sysfs 'green:wlan'
	option trigger 'netdev'
	option dev 'phy0-ap0'
	list mode 'link'
	list mode 'tx'
	list mode 'rx'

config led
	option name 'WAN'
	option sysfs 'green:wan-online'
	option trigger 'netdev'
	option dev 'eth0'
	list mode 'link'
	list mode 'tx'
	list mode 'rx'

config led
	option name 'USB'
	option sysfs 'green:usb'
	option trigger 'usbport'
	list port 'usb1-port1'
	list port 'usb2-port1'

